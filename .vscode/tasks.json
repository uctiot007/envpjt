{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Promote Game to Collection",
      "type": "shell",
      "command": "mongosh",
      "args": [
        "mongodb://teamuser:teampassword123@172.25.5.110:27017/gamesDB?authSource=admin",
        "--eval",
        "var fitgirlId='${input:fitgirlId}'; var targetList='${input:targetList}';",
        "${workspaceFolder}\\scripts\\promote.js"
      ],
      "options": {
        "shell": {
          "executable": "cmd",
          "args": [
            "/d",
            "/c"
          ]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      },
